<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <!-- Detour signatures with pointer parameters need pointer delegates in the tests that cover them. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Tests exercise the Windows-only NoireLib assembly and only ever run on Windows. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <DalamudPath>$(appdata)\xivlauncher\Addon\Hooks\dev\</DalamudPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoireLib\NoireLib.csproj" />
    <!-- Wired the way a consumer plugin wires them, to compile probe configuration classes against the generated accessors. -->
    <ProjectReference Include="..\NoireLib.SourceGenerators\NoireLib.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

    <ItemGroup>
        <Reference Include="Dalamud">
            <HintPath>$(DalamudPath)Dalamud.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="Dalamud.Bindings.ImGui">
            <HintPath>$(DalamudPath)Dalamud.Bindings.ImGui.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="Dalamud.Bindings.ImGuizmo">
            <HintPath>$(DalamudPath)Dalamud.Bindings.ImGuizmo.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="Dalamud.Bindings.ImPlot">
            <HintPath>$(DalamudPath)Dalamud.Bindings.ImPlot.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="FFXIVClientStructs">
            <HintPath>$(DalamudPath)FFXIVClientStructs.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="InteropGenerator.Runtime">
            <HintPath>$(DalamudPath)InteropGenerator.Runtime.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="Lumina">
            <HintPath>$(DalamudPath)Lumina.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="Lumina.Excel">
            <HintPath>$(DalamudPath)Lumina.Excel.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="Microsoft.Extensions.ObjectPool">
            <HintPath>$(DalamudPath)Microsoft.Extensions.ObjectPool.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="Newtonsoft.Json">
            <HintPath>$(DalamudPath)Newtonsoft.Json.dll</HintPath>
            <Private>True</Private>
        </Reference>

        <Reference Include="Serilog">
            <HintPath>$(DalamudPath)Serilog.dll</HintPath>
            <Private>True</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <!-- SQLitePCLRaw's native library. The Dalamud runtime supplies it; copied here for the test host to load it directly. -->
      <None Include="$(DalamudPath)runtimes\win-x64\native\e_sqlite3.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />

      <!-- cimgui.dll for UiHarness's real ImGui frames. Copied by the build so a clean clone can still run the drawing tests. -->
      <None Include="$(DalamudPath)cimgui.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>
</Project>
